# Film Comp Check settings. Names only: copy to .env.local and fill in your own values. Never commit values.
# With none of these set the app runs in judge mode: recorded samples replay with 0 Qloo calls (see README).

# Qloo (server only). Unset = no live Qloo calls.
QLOO_API_KEY=
# 0 pauses live Qloo checks outright.
QLOO_LIVE=
# 1 offers "Run live on Qloo" on the sample decks. Unset = off: samples show only "Run again".
SAMPLE_LIVE=

# Agent. Unset = built-in rule-following stub off Vercel; claude = Claude with the key below.
AGENT_PROVIDER=
QLOO_ANTHROPIC_API_KEY=
AGENT_MODEL=
AGENT_MAX_STEPS=
AGENT_MAX_TOKENS=

# Store. Unset = in-memory (empty). A local file store, or one full Upstash/Vercel KV pair.
STORE_FILE_DIR=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Daily limits.
IP_DAILY_LIVE_CHECKS=
IP_HASH_SALT=
FIREWALL_RATE_LIMIT_ID=

# Local dev cache of raw Qloo responses (git-ignored, off on Vercel).
COMP_CACHE_DIR=
